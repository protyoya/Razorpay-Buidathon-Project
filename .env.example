# ---- Razorpay TEST MODE ONLY ----
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
# key_id ALWAYS starts with rzp_test_ for test mode. If it starts with rzp_live_, STOP.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- LLM: pick ONE ----
# (a) Anthropic direct:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# (b) OR OpenRouter - uses its Anthropic-compatible endpoint, no code change.
#     If this is set it WINS over ANTHROPIC_API_KEY. Model ids get an
#     "anthropic/" prefix added automatically.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Optional overrides
# MODEL_ID=claude-opus-5          # or claude-sonnet-4.6 for cheaper/faster
# MODEL_EFFORT=low                # low keeps demo turns snappy
# LLM_STRICT_COMPAT=true          # drop Anthropic-only fields if your gateway 400s
#                                 # (run `npm run smoke:llm` to find out)

# port 3000 is often taken; 4123 is just a free default
PORT=4123
PUBLIC_BASE_URL=http://localhost:4123

# ---- LLM failover (optional but recommended) ----
# Used automatically if the primary is rate-limited or out of credit.
# Free key, no card: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Voice (optional, Fish Audio) ----
# Leave blank and the app stays typing-only; the mic button hides itself.
# Get a key at https://fish.audio  -> s2.1-pro-free is free under fair use.
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_MODEL=s2.1-pro-free
# FISH_AUDIO_VOICE_ID=            # optional cloned/community voice id
# FISH_AUDIO_SPEED=1

# ---- Deepgram (speech-to-text; $200 free credits, no card) ----
# https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Provider routing: auto | deepgram | fish
# auto = STT via Deepgram (free credits cover it), TTS via Fish (s2.1-pro-free is free)
# VOICE_STT_PROVIDER=auto
# VOICE_TTS_PROVIDER=auto

# ---- Demo controls ----
# Flip to "true" to force the next payment to fail (graceful-failure demo)
DEMO_FORCE_PAYMENT_FAILURE=false
